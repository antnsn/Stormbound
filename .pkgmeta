package-as: Stormbound

# CurseForge shows this file as the changelog of each release (newest version on top)
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - docs
  - tests
  - tools
  - .luacheckrc
  - wowbench.toml
  - CLAUDE.md
  - AGENTS.md
  - .beads
  - .claude
  - CURSEFORGE.md
  - Stormbound.png
  - README.md
